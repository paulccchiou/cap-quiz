pdf/*.pdf

# Study materials (audio/screenshots) — keep local, do not push
*.m4a
*.mp3
*.mp4
# Top-level images that aren't part of the app (app images live under wwwroot/images/)
/*.png
/*.jpg
/*.jpeg
